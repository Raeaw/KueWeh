<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Gambar Produk -->
    <ImageView
        android:id="@+id/imgPesanan"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_image_rounded"
        android:scaleType="centerCrop"/>

    <!-- Info Produk -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvNamaPesanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Kue"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tvHargaPesanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="#FF7043"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <!-- Rating & Status Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <!-- Badge Status (untuk pelanggan) -->
            <TextView
                android:id="@+id/tvStatusPesananBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_chip_inactive"
                android:layout_marginEnd="8dp"/>

            <!-- Rating Button -->
            <TextView
                android:id="@+id/tvRatingItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Rating"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                android:background="@drawable/bg_chip_inactive"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <!-- Panel Admin (tersembunyi secara default) -->
        <LinearLayout
            android:id="@+id/layoutAdminItemControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAdminItemStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pending"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF9800"/>

            <Button
                android:id="@+id/btnAdminItemAksi"
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:text="Terima"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#2196F3"
                android:padding="0dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>