<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ROW UTAMA: Gambar | Info | Rating | Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <!-- Gambar -->
            <ImageView
                android:id="@+id/imgPesanan"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="centerCrop"
                android:background="#F0EBE3"/>

            <!-- Nama + Harga — diberi weight agar tidak mepet -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp">

                <TextView
                    android:id="@+id/tvNamaPesanan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Kue"
                    android:textColor="#1E1C18"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvHargaPesanan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Rp 0"
                    android:textColor="#FF7043"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Rating tombol — lebar fixed kecil -->
            <TextView
                android:id="@+id/tvRatingItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ Rating"
                android:textColor="#1E1C18"
                android:textSize="12sp"
                android:layout_marginRight="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"/>

            <!-- Badge status -->
            <TextView
                android:id="@+id/tvStatusPesananBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF3E0"
                android:textColor="#FF9800"
                android:text="Pending"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- PANEL ADMIN (hidden untuk pelanggan) -->
        <LinearLayout
            android:id="@+id/layoutAdminItemControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="@drawable/bg_search_rounded">

            <TextView
                android:id="@+id/tvAdminItemStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pending"
                android:textColor="#FF9800"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnAdminItemAksi"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#2196F3"
                android:text="Terima"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>