<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Tambah Produk Baru"
            android:textColor="#1E1C18"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btnPilihFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#757575"
            android:text="Pilih Foto dari Galeri" />

        <EditText
            android:id="@+id/etNamaKue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_rounded"
            android:hint="Nama Kue (Contoh: Lapis Legit)"
            android:paddingHorizontal="16dp" />

        <EditText
            android:id="@+id/etHargaKue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan Harga (contoh: 50000)"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="16dp"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategori Produk"
            android:textColor="#1E1C18"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerKategori"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnSimpanProduk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#F5A67B"
            android:text="Simpan Produk"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>