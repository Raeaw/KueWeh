<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F3">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF7043"
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kue Weh! 🍰"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temukan kue favoritmu hari ini"
                    android:textColor="#FFCCBC"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Logo: pakai drawable yang sudah ada, ukuran kecil -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_logo_kueweh"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_search_rounded"
                android:padding="6dp"/>
        </LinearLayout>

        <!-- Search bar: lebar penuh dalam padding header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_search"
                android:alpha="0.4"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:background="@null"
                android:hint="Cari kue, cookies, minuman..."
                android:textColorHint="#BDBDBD"
                android:textColor="#1E1C18"
                android:textSize="13sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- FILTER CHIPS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFilterSemua"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/bg_chip_active"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="✦ Semua"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFilterCake"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🎂 Cake"
                android:textColor="#757575"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvFilterCookies"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🍪 Cookies"
                android:textColor="#757575"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvFilterDrink"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="🧋 Drink"
                android:textColor="#757575"
                android:textSize="12sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CONTENT AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="16dp"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"/>

        <LinearLayout
            android:id="@+id/emptyStateHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="40dp"
            android:paddingRight="40dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="52sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Produk Tidak Ditemukan"
                android:textColor="#1A1A1A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Coba kata kunci lain atau pilih kategori berbeda"
                android:textColor="#BDBDBD"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>